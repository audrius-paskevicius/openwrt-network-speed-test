#!/bin/sh /etc/rc.common
START=95
USE_PROCD=1
start_service() {
 local device
 device=$(ubus call network.interface.lan status 2>/dev/null | jsonfilter -e '@.l3_device')
 [ -n "$device" ] || return 1
 procd_open_instance
 procd_set_param command /www/cgi-bin/network-speed-test serve "$device"
 procd_set_param respawn
 procd_set_param stdout 1
 procd_set_param stderr 1
 procd_set_param limits nofile="128 128"
 procd_close_instance
}
service_triggers() {
 procd_add_reload_trigger network
 procd_add_interface_trigger "interface.*" lan /etc/init.d/network-speed-test restart
}
